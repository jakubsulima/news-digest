{
  "name": "daily-news-digest",
  "private": true,
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.30.1"
  },
  "scripts": {
    "install:check": "pnpm install --frozen-lockfile",
    "audit": "pnpm audit",
    "audit:prod": "pnpm audit --prod",
    "knip": "knip --no-progress --include files,dependencies,unlisted,binaries,unresolved",
    "knip:exports": "knip --no-progress --exports",
    "dev:reader": "pnpm --dir apps/reader dev",
    "build:reader": "pnpm --dir apps/reader build",
    "lint:reader": "pnpm --dir apps/reader lint",
    "test:reader": "pnpm --dir apps/reader test",
    "typecheck:reader": "pnpm --dir apps/reader typecheck",
    "build": "pnpm build:reader",
    "typecheck": "pnpm typecheck:reader"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "2.11.21",
      "browserslist": "4.28.7",
      "next>sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "postcss": ">=8.5.18",
      "postcss>nanoid": "3.3.18"
    }
  },
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "knip": "^5.88.1"
  }
}
